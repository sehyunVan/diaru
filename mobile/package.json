{
  "name": "diaru-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Capacitor 껍데기. 앱은 ../dist-mobile 을 담는다 — tools/pack-mobile.mjs 가 dist/ 에서 굽고 서버 주소를 박는다.",
  "scripts": {
    "pack": "node ../tools/pack-mobile.mjs",
    "sync": "node ../tools/pack-mobile.mjs && cap sync",
    "version": "node ../tools/version.mjs",
    "apk": "cd android && gradlew.bat assembleDebug",
    "release-apk": "cd android && gradlew.bat assembleRelease",
    "aab": "cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}

{
  "appId": "sarl.diaru.app",
  "appName": "Diaru",
  "webDir": "../dist-mobile",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "zoomEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "zoomEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 0,
      "backgroundColor": "#fdfaf4",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
